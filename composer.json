{
    "name": "alaindessi/adweb",
    "version": "dev-develop8-4",
    "type": "library",
    "description": "Buscobon PHP components",
    "license": "MIT",
    "authors": [
        {
            "name": "Alain Dessi",
            "email": "contact@alain-dessi.com",
            "homepage": "https://alain-dessi.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Core\\": "",
            "": "Facades/"
        }
    },
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "ext-json": "*",
